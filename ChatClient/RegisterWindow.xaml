<Window x:Class="ChatClient.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Discord - Đăng ký"
        Height="680"
        Width="980"
        MinHeight="680"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#0F1115">

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBackground"
                         Color="#0F1115"/>

        <SolidColorBrush x:Key="LeftPanelBackground"
                         Color="#14171C"/>

        <SolidColorBrush x:Key="CardBackground"
                         Color="#181B21"/>

        <SolidColorBrush x:Key="InputBackground"
                         Color="#101217"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#292E38"/>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#6472F8"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#7380FF"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#F3F4F6"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#9299A8"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#616875"/>

        <SolidColorBrush x:Key="DangerBrush"
                         Color="#F06A7A"/>


        <Style TargetType="{x:Type TextBox}">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Margin"
                    Value="0,7,0,14"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <Style TargetType="{x:Type PasswordBox}">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Margin"
                    Value="0,7,0,14"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <Style x:Key="PrimaryButton"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="SecondaryButton"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="41"/>

            <Setter Property="Background"
                    Value="#20242B"/>

            <Setter Property="Foreground"
                    Value="#D8DCE4"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="BorderBrush"
                    Value="#303641"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>


    <Grid Background="{StaticResource WindowBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*"/>
            <ColumnDefinition Width="0.92*"/>
        </Grid.ColumnDefinitions>


        <Grid Grid.Column="0"
              Background="{StaticResource LeftPanelBackground}">

            <Grid Margin="70">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="370">

                    <Border Width="58"
                            Height="58"
                            CornerRadius="12"
                            Background="#202635"
                            BorderBrush="#39435E"
                            BorderThickness="1"
                            HorizontalAlignment="Center">

                        <TextBlock Text="M"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#8390FF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <TextBlock Text="Tạo tài khoản"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,22,0,7"/>


                    <TextBlock Text="Tạo tài khoản để bắt đầu sử dụng Mini Discord."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>


                    <Border Background="#191D24"
                            BorderBrush="#262C36"
                            BorderThickness="1"
                            Padding="18"
                            CornerRadius="6"
                            Margin="0,38,0,0">

                        <StackPanel>

                            <TextBlock Text="TÀI KHOẢN"
                                       Foreground="#737B89"
                                       FontSize="10"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Đơn giản và riêng tư"
                                       Foreground="#E6E8EC"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,8"/>

                            <TextBlock Text="Trò chuyện với bạn bè • Kết nối thời gian thực"
                                       Foreground="#858D9B"
                                       FontSize="12"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <TextBlock Grid.Row="1"
                           Text="© PVV"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,5"/>

            </Grid>

        </Grid>


        <Grid Grid.Column="1"
              Background="{StaticResource WindowBackground}">

            <Border Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="#292E38"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="34">

                <StackPanel>

                    <TextBlock Text="Đăng ký tài khoản"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="Điền thông tin bên dưới"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"
                               Margin="0,6,0,22"/>


                    <TextBlock Text="TÊN ĐĂNG NHẬP"
                               Foreground="#AAB0BC"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBox x:Name="UsernameTextBox"
                             ToolTip="Nhập tên đăng nhập"/>


                    <TextBlock Text="EMAIL"
                               Foreground="#AAB0BC"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBox x:Name="EmailTextBox"
                             ToolTip="Nhập địa chỉ email"/>


                    <TextBlock Text="MẬT KHẨU"
                               Foreground="#AAB0BC"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <PasswordBox x:Name="PasswordBox"/>


                    <TextBlock Text="NHẬP LẠI MẬT KHẨU"
                               Foreground="#AAB0BC"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <PasswordBox x:Name="ConfirmPasswordBox"/>


                    <Button x:Name="RegisterButton"
                            Content="Đăng ký"
                            Style="{StaticResource PrimaryButton}"
                            Click="RegisterButton_Click"/>


                    <Button Content="Quay lại đăng nhập"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,10,0,0"
                            Click="BackButton_Click"/>


                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,13,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>
<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Discord"
        Height="760"
        Width="1100"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115">

    <Window.Resources>

        <!-- ================= MÀU ================= -->

        <SolidColorBrush x:Key="MainBackground"
                         Color="#0F1115"/>

        <SolidColorBrush x:Key="SidebarBackground"
                         Color="#15181E"/>

        <SolidColorBrush x:Key="PanelBackground"
                         Color="#191C22"/>

        <SolidColorBrush x:Key="InputBackground"
                         Color="#101217"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#292E38"/>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#6472F8"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#7380FF"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#F3F4F6"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#9299A8"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#626A77"/>

        <SolidColorBrush x:Key="DangerBrush"
                         Color="#E96B7A"/>


        <!-- ================= Ô NHẬP ================= -->

        <Style TargetType="{x:Type TextBox}">

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>


        <!-- ================= NÚT CHÍNH ================= -->

        <Style x:Key="PrimaryButton"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================= NÚT PHỤ ================= -->

        <Style x:Key="SecondaryButton"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="#20242B"/>

            <Setter Property="Foreground"
                    Value="#D8DCE4"/>

            <Setter Property="BorderBrush"
                    Value="#303641"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ================= DANH SÁCH ================= -->

        <Style TargetType="{x:Type ListBox}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

        </Style>


        <Style TargetType="{x:Type ListBoxItem}">

            <Setter Property="Foreground"
                    Value="#D9DCE2"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Padding"
                    Value="10,9"/>

            <Setter Property="Margin"
                    Value="0,1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ListBoxItem}">

                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#1E2229"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#252B3A"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ===================================================== -->
    <!-- GIAO DIỆN CHÍNH -->
    <!-- ===================================================== -->

    <Grid Background="{StaticResource MainBackground}">

        <Grid.ColumnDefinitions>

            <!-- BẠN BÈ -->

            <ColumnDefinition Width="300"/>

            <!-- CHAT -->

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- KHU BẠN BÈ -->
        <!-- ================================================= -->

        <Grid Grid.Column="0"
              Background="{StaticResource SidebarBackground}">

            <Grid.RowDefinitions>

                <!-- Tiêu đề -->

                <RowDefinition Height="72"/>

                <!-- Thêm bạn -->

                <RowDefinition Height="Auto"/>

                <!-- Danh sách -->

                <RowDefinition Height="*"/>

                <!-- Tài khoản -->

                <RowDefinition Height="64"/>

            </Grid.RowDefinitions>


            <!-- ================= TIÊU ĐỀ ================= -->

            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">

                <Grid Margin="20,0">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Bạn bè"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Danh sách liên hệ"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================= THÊM BẠN ================= -->

            <Border Grid.Row="1"
                    Margin="15,15,15,10"
                    Padding="12"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                <StackPanel>

                    <TextBlock Text="Thêm bạn mới"
                               Foreground="#AAB1BD"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="1,0,0,7"/>


                    <TextBox x:Name="FriendUsernameTextBox"
                             Height="38"
                             ToolTip="Nhập tên đăng nhập"/>


                    <Button Content="Thêm bạn"
                            Height="36"
                            Margin="0,3,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="AddFriendButton_Click"/>

                </StackPanel>

            </Border>


            <!-- ================= DANH SÁCH ================= -->

            <Grid Grid.Row="2"
                  Margin="15,4,15,8">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="155"/>

                </Grid.RowDefinitions>


                <!-- Bạn bè -->

                <TextBlock Grid.Row="0"
                           Text="DANH SÁCH BẠN BÈ"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="3,5,0,7"/>


                <ListBox Grid.Row="1"
                         x:Name="UsersListBox"
                         FontSize="13"/>


                <!-- Lời mời -->

                <TextBlock Grid.Row="2"
                           Text="LỜI MỜI KẾT BẠN"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="3,12,0,7"/>


                <Grid Grid.Row="3">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <ListBox Grid.Row="0"
                             x:Name="FriendRequestsListBox"
                             FontSize="12"/>


                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,7,0,0">

                        <Button Content="Chấp nhận"
                                Width="92"
                                Height="30"
                                Margin="0,0,6,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="AcceptFriendButton_Click"/>


                        <Button Content="Từ chối"
                                Width="92"
                                Height="30"
                                Style="{StaticResource SecondaryButton}"
                                Click="RejectFriendButton_Click"/>

                    </StackPanel>

                </Grid>

            </Grid>


            <!-- ================= TÀI KHOẢN ================= -->

            <Border Grid.Row="3"
                    Background="#101217"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="15,10">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="UserText"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Đang trực tuyến"
                                   Foreground="#65C89A"
                                   FontSize="10"
                                   Margin="0,2,0,0"/>

                    </StackPanel>


                    <Button Grid.Column="1"
                            Content="Đăng xuất"
                            Width="70"
                            Height="30"
                            Style="{StaticResource SecondaryButton}"
                            Click="LogoutButton_Click"/>

                </Grid>

            </Border>

        </Grid>


        <!-- ================================================= -->
        <!-- KHU CHAT -->
        <!-- ================================================= -->

        <Grid Grid.Column="1"
              Background="{StaticResource MainBackground}">

            <Grid.RowDefinitions>

                <!-- Header -->

                <RowDefinition Height="72"/>

                <!-- Nội dung -->

                <RowDefinition Height="*"/>

                <!-- Ô nhập -->

                <RowDefinition Height="72"/>

                <!-- Nút gửi -->

                <RowDefinition Height="48"/>

                <!-- Copyright -->

                <RowDefinition Height="22"/>

            </Grid.RowDefinitions>


            <!-- ================= HEADER ================= -->

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="22,0">

                <Grid>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Tin nhắn"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="19"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Chọn một người bạn để bắt đầu trò chuyện"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================= KHUNG CHAT ================= -->

            <Border Grid.Row="1"
                    Margin="18"
                    Background="#13161B"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                <ScrollViewer x:Name="ChatScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="ChatPanel"
                                Margin="16"/>

                </ScrollViewer>

            </Border>


            <!-- ================= NHẬP TIN NHẮN ================= -->

            <Grid Grid.Row="2"
                  Margin="18,0,18,8">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <TextBox x:Name="MessageTextBox"
                         Grid.Column="0"
                         Height="46"
                         FontSize="13"
                         ToolTip="Nhập tin nhắn..."/>


                <Button Grid.Column="1"
                        x:Name="RecordVoiceButton"
                        Content="🎙 Ghi âm"
                        Width="100"
                        Height="46"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="RecordVoiceButton_Click"/>


                <Button Grid.Column="2"
                        Content="Chọn tệp"
                        Width="82"
                        Height="46"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="SendFileButton_Click"/>

            </Grid>


            <!-- ================= GỬI ================= -->

            <Grid Grid.Row="3"
                  Margin="18,0,18,6">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>


                <Button Grid.Column="1"
                        Content="Gửi tin nhắn"
                        Width="130"
                        Height="38"
                        Style="{StaticResource PrimaryButton}"
                        Click="SendMessageButton_Click"/>

            </Grid>


            <!-- ================= COPYRIGHT ================= -->

            <TextBlock Grid.Row="4"
                       Text="© PVV"
                       Foreground="#555B67"
                       FontSize="9"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>

        </Grid>

    </Grid>

</Window>
